  "python-tooling": {
    "status": "supported",
    "markers": [
      "pyproject.toml",
      "tests/test*.py"
    ],
    "required": [],
    "tools": [
      "python"
    ],
    "commands": [
      [
        "python",
        "-c",
        "import sys, unittest; suite = unittest.defaultTestLoader.discover(\"tests\"); count = suite.countTestCases(); print(\"Discovered tests:\", count); result = unittest.TextTestRunner(verbosity=2).run(suite); print(\"Executed non-skipped tests:\", result.testsRun-len(result.skipped)); sys.exit(0 if count > 0 and result.testsRun > len(result.skipped) and result.wasSuccessful() else 1)"
      ]
    ],
    "install": [],
    "description": "Python unittest profile, including standalone stdlib repositories; explicit project dependencies remain separate"
  },
