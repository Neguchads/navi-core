{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "requirement": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "not-demonstrated"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "requirement",
    "commit",
    "command",
    "status",
    "exit_code",
    "artifact_sha256"
  ],
  "additionalProperties": false
}
