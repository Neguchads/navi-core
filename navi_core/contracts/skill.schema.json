{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "deprecated"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude",
          "copilot",
          "gemini",
          "nexus"
        ]
      }
    },
    "required_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "source",
    "license",
    "status",
    "risk",
    "hosts",
    "required_tools"
  ],
  "additionalProperties": false
}
