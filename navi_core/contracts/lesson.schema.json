{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "enum": [
        "preference",
        "decision",
        "lesson",
        "correction"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "validation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "summary",
    "source_reference",
    "validation"
  ],
  "additionalProperties": false
}
